rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // 1. HELPER PRIMITIVES
    // ---------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "phonkphonkswe@gmail.com"
      );
    }

    // ---------------------------------------------------------
    // 2. VALIDATION HELPERS
    // ---------------------------------------------------------
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'username']) &&
             data.uid == request.auth.uid &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 32 &&
             (data.get('displayName', '') is string) &&
             (data.get('robux', 0) is number) &&
             (data.get('drovis', 0) is number) &&
             (data.get('rank', 'Bronze') is string);
    }

    function isValidGame(data) {
      return data.keys().hasAll(['id', 'title', 'creatorUid']) &&
             data.id is string && data.id.size() <= 64 &&
             data.title is string && data.title.size() <= 100 &&
             data.creatorUid == request.auth.uid &&
             (data.get('playing', 0) is number) &&
             (data.get('likesCount', 0) is number);
    }

    // ---------------------------------------------------------
    // 3. GLOBAL SAFETY NET
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // 4. COLLECTION MATCHES
    // ---------------------------------------------------------

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Standard list for search, but should ideally be secured further
      
      allow create: if isOwner(userId) && isValidUser(incoming());
      
      allow update: if (isOwner(userId) || isAdmin()) && isValidUser(incoming()) && (
        isAdmin() || (
          // Action: Update Profile
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'avatarConfig', 'settings', 'gallery', 'isUpdated', 'lastUsernameChange', 'usernameChangeCards', 'friends', 'acceptedToS'
          ])
        )
      );
      
      allow delete: if isAdmin();
    }

    // Username mapping (Index)
    match /users_by_username/{username} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().uid == request.auth.uid;
      allow update: if isAdmin();
    }

    // Games Collection
    match /games/{gameId} {
      allow read: if true;
      allow create: if isEmailVerified() && isValidGame(incoming());
      
      allow update: if (incoming().creatorUid == request.auth.uid || isAdmin()) && isValidGame(incoming()) && (
        isAdmin() || (
          // Standard Update
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'thumbnail', 'likes', 'likesCount', 'stars', 'starCount', 'playing', 'mapData', 'skybox'
          ])
        )
      );
      
      allow delete: if (existing().creatorUid == request.auth.uid || isAdmin());
    }

    // Videos Collection
    match /videos/{videoId} {
      allow read: if true;
      allow create: if isEmailVerified() && incoming().creatorUid == request.auth.uid;
      allow update: if isSignedIn() && (
        // Allow anyone signed in to like? No, should be restricted or use subcollection
        incoming().diff(existing()).affectedKeys().hasOnly(['likes'])
      );
      allow delete: if (existing().creatorUid == request.auth.uid || isAdmin());
    }

    // Reports Collection (Write-Only for users)
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && incoming().reporterUid == request.auth.uid;
    }

    // Global Settings
    match /global_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Studio Maps (Voxel data)
    match /studio_maps/{username} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (username == request.auth.uid || isAdmin());
    }
  }
}
